---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

import es from '../data/es.json'
import en from '../data/en.json'

const lang = Astro.url.pathname.startsWith('/es') ? 'es' : 'en'
const t = lang === 'es' ? es : en

const currentPath = Astro.url.pathname
const {bg, altEn, altEs, title, description} = Astro.props
const fallbackAltPath = lang === 'es' 
	? currentPath.replace(/^\/es/, '') || '/'
	: `/es${currentPath}`

const enUrl = lang === 'en' ? currentPath : (altEn ?? fallbackAltPath)
const esUrl = lang === 'es' ? currentPath : (altEs ?? fallbackAltPath)

const whatsapp =
  `https://wa.me/5493512377435?text=${encodeURIComponent(t.contact.whatsapp)}`

const mailto =
  `mailto:maximo2004lfn@gmail.com?subject=${encodeURIComponent(t.contact.emailSubject)}&body=${encodeURIComponent(t.contact.emailBody)}`

const canonicalUrl = `https://maximowebs.pages.dev${currentPath}`
const pageTitle = title ?? t.seo.title
const pageDescription = description ?? t.seo.description
---
<!doctype html>
<html lang={lang}>
	<head>
		<meta name="google-site-verification" content="HUjHxsLBHinTos0tun6s_0w3Eo1fiireXmFQoNG-uqk" />
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />

		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="en" href={`https://maximowebs.pages.dev${enUrl}`} />
		<link rel="alternate" hreflang="es" href={`https://maximowebs.pages.dev${esUrl}`} />
		<link rel="alternate" hreflang="x-default" href={`https://maximowebs.pages.dev${enUrl}`} />


		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:image" content="https://maximowebs.pages.dev/og-default.png" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:image" content="https://maximowebs.pages.dev/og-default.png" />


		<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": ["Person", "ProfessionalService"],
  "name": "Máximo Silva",
  "jobTitle": t.schema.jobTitle,
  "url": "https://maximowebs.pages.dev",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Córdoba",
    "addressCountry": "AR"
  },
  "telephone": "+5493512377435",
  "email": "maximo2004lfn@gmail.com"
})} />
	</head>
	<body class="relative pt-5 lg:pt-10">

		{bg && 
			<div 
				class="absolute inset-0 -z-10 opacity-[0.3]"
				style="background-image: radial-gradient(circle, #000 1px, transparent 1px); background-size: 24px 24px;"
			></div>
		}

		<Header />
		<slot />
		<a 
		href={whatsapp}
		rel="noopener noreferrer"
		aria-label="Contactar desarrollador web por WhatsApp" 
		target="_blank" class='flex items-center justify-center whsp fixed right-5 bottom-5 lg:bottom-10 lg:right-10 bg-green-400 rounded-[100%_100%_0_100%] w-fit p-4 hover:bg-green-500 transition-bg shadow-[0_10px_20px_rgba(0,0,0,0.03)] ease duration-150'>
			<svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9" /><path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1" /></svg>
		</a>
		<Footer />
	</body>
</html>

<style>


	html {
		overflow-x: hidden;
	}

	.whsp {
		transform: translate(0, 200%);
		animation: whsp-entry .6s cubic-bezier(.34, 1.56,.64,1) forwards;
		animation-delay: .75s;
		z-index: 90;
	}

	@keyframes whsp-entry {
		from {
			transform: translate(0, 100%);
			scale: .8;
			opacity: 0;
		}
		to {
			opacity: 1;
			transform: translate(0, 0);
			scale: 1;
		}
	}
</style>