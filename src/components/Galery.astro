---
import Carousel from './Carousel.jsx';
const {t} = Astro.props;
---

<section class="relative flex py-20 bg-[#fbfbfb] global-padding" id="proyectos">

	<div class="max-w-[1380px] grid gap-10 mx-auto">
	<div class="pointer-events-none absolute top-0 left-0 h-20 w-full bg-gradient-to-b from-white to-[#fbfbfb]" />
	<div class="pointer-events-none absolute bottom-0 left-0 h-20 w-full bg-gradient-to-b from-[#fbfbfb] to-white" />

	<div class="flex flex-col gap-2">
		<h2 class="text-3xl lg:text-5xl font-semibold">{t.title}</h2>
		<p class="lg:text-xl text-[rgba(0,0,0,0.6)]">{t.subtitle}<br class="hidden lg:inline">{t.subtitleRest}</p>
	</div>


	<div class="flex flex-col gap-5">
		<div class="grid grid-cols-1 lg:grid-cols-3 w-full gap-5">
			{t.projects.map(a => { 
				const Tag = a.url ? 'a' : 'span'
				return (
					<article class="group">				
						<Tag {...(a.url ? {href: a.url, 'aria-label': `Ir a la web del proyecto ${a.title}`, target: '_blank'} : {})} class="flex flex-col min-h-40 h-full relative">
							<div class="overflow-hidden bg-white h-60 w-full aspect-square">
								<img width="300" height="300" src={a.images} alt={a.title} loading={a.id === 7 ? 'lazy' : 'eager'} class="group-hover:scale-[1.05] transition-scale duration-250 ease h-full w-full object-cover" />
								{a.url && (
									<span class="text-[#eee] font-medium absolute top-5 right-5 p-2 bg-[#000a] text-xs flex items-center gap-1">
										<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-link"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M9 15l6 -6" /><path d="M11 6l.463 -.536a5 5 0 0 1 7.071 7.072l-.534 .464" /><path d="M13 18l-.397 .534a5.068 5.068 0 0 1 -7.127 0a4.972 4.972 0 0 1 0 -7.071l.524 -.463" /></svg>
										enlace
									</span>
								)}
							</div>
							<div class="flex flex-col pt-4">
								<span class="text-[.8rem] text-[rgba(0,0,0,0.7)] font-medium">{a.tags}</span>
								<h3 class="mb-4 text-lg font-semibold">{a.title}</h3>
								<div class="relative">
									<p 
										class="text-[rgba(0,0,0,0.5)] line-clamp-4 desc-text" 
										style="white-space: pre-line;"
										data-full={a.desc}
									>
										{a.desc}
									</p>
									<button 
										class="ver-mas text-sm font-medium text-[rgba(0,0,0,0.9)] cursor-pointer underline mt-1 hover:opacity-60 transition-opacity"
									>
										Ver más
									</button>
								</div>
							</div>
						</Tag>
					</article>
				)}
			)}
		</div>
	</div>

	</div>

</section>

<script>
  document.querySelectorAll('.ver-mas').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault()
      e.stopPropagation()
      
      const p = btn.previousElementSibling
      const isExpanded = p.classList.contains('line-clamp-4')

      if (isExpanded) {
        p.classList.remove('line-clamp-4')
        btn.textContent = 'Ver menos'
      } else {
        p.classList.add('line-clamp-4')
        btn.textContent = 'Ver más'
      }
    })
  })
</script>