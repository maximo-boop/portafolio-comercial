---
import Cart from '../assets/icons/Cart.astro'
import Action from '../assets/icons/Action.astro'
import Empresa from '../assets/icons/Empresa.astro'
import Visual from '../assets/icons/Visual.astro'

const icons = {
	compra: Cart,
	action: Action,
	empresa: Empresa,
	visual: Visual,
}
const {t} = Astro.props;

---

<section class="mt-20 lg:mt-24 mb-10">

	<div class="lg:max-w-[80%] mx-auto overflow-x-hidden relative">
		<div class="w-fit animate-carousel flex gap-10">
			{[...t,...t].map(a => { 
				const Icon = icons[a.icon];
				return (
				<div class="flex items-center gap-2">
					{Icon && <Icon strokeW={2.2} />}
					<p class="font-semibold text-xl text-nowrap">{a.title}</p>
				</div>
			)})}
		</div>

		<div class="bg-gradient-to-r from-white to-transparent absolute left-0 top-0 h-full w-40 z-10" />
		<div class="bg-gradient-to-l from-white to-transparent absolute right-0 top-0 h-full w-40 z-10" />

	</div>

</section>

<style>
	
	.animate-carousel {
		animation: carousel 30s linear infinite;
	}

	@keyframes carousel {
		from { transform: translateX(0); }
		to { transform: translateX(-50%); }
	}

</style>