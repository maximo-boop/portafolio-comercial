---
import Action from '../assets/icons/Action.astro'
import Empresa from '../assets/icons/Empresa.astro'
import Cart from '../assets/icons/Cart.astro'

const {t} = Astro.props
---

<section class="flex flex-col gap-10 mt-20 mb-40">
	<div class="flex flex-col gap-2 text-center">
		<h2 class="text-3xl lg:text-5xl font-semibold">{t.title}</h2>
		<p class="lg:text-xl text-[rgba(0,0,0,0.7)]">{t.subtitle}</p>
	</div>

	<ul class="grid grid-cols-1 lg:grid-cols-3 w-full gap-5">
		{t.serv.map((s, i) => (
			<li class={`${i===0 ? 'lg:col-span-2 shadow-[0_0_20px_0_rgba(0,0,0,0.06)]' : i===3 ? 'lg:col-span-2' : ''} hover:shadow-[0_0_20px_0_rgba(0,0,0,0.06)] flex flex-col gap-2 border border-[#ddd] p-5 transition-shadow duration-200`}>
				<span class="text-xl font-bold text-[var(--primary)]">0{i+1}</span>
				<h3 class="text-xl font-bold">{s.title}</h3>
				<p class="text-[rgba(0,0,0,0.5)]">{s.des}</p>
			</li>
		))}
	</ul>
	
</section>