---
import Action from '../assets/icons/Action.astro'
import Empresa from '../assets/icons/Visual.astro'
import Redesign from '../assets/icons/Custom.astro'
import Cart from '../assets/icons/Cart.astro'
const {t} = Astro.props

const icons = [Action, Empresa, Redesign, Cart] // ajustá según cuál corresponda a cada servicio
const categorias = ["Contacto directo", "Vitrina digital", "Optimización", "Venta online"]
---
<section class=" flex flex-col gap-10 mb-40">
	<!-- Textura de fondo sutil -->

	<div class="flex flex-col gap-2">
		<h2 class="text-3xl lg:text-4xl font-semibold">{t.title}</h2>
		<p class="lg:text-lg text-[rgba(0,0,0,0.7)]">{t.subtitle}</p>
	</div>

	<ul class="grid grid-cols-1 lg:grid-cols-3 w-full gap-5">
		{t.serv.map((s, i) => {
			const Icon = icons[i]
			return (
				<li class={`${i===0 ? 'lg:col-span-2 -translate-y-1 border-[var(--primary)] shadow-[0_10px_15px_-3px_#0000000a,0_4px_6px_-2px_#00000005]' : i===3 ? 'lg:col-span-2' : ''} group relative flex flex-col gap-3 border border-[#e5e5e5] p-6 lg:p-8 transition-all duration-300 bg-white hover:border-[var(--primary)] hover:-translate-y-1 hover:shadow-[0_10px_15px_-3px_#0000000a,0_4px_6px_-2px_#00000005] overflow-hidden`}>
				
					
					<div class={`${i===0 ? 'bg-[var(--primary)] text-white' : 'bg-[var(--primary)]/5 text-[var(--primary)]'} relative z-10 w-12 h-12 flex items-center justify-center group-hover:bg-[var(--primary)] group-hover:text-white transition-colors duration-300`}>
						<Icon strokeW={2} />
					</div>

					<h3 class="relative z-10 text-xl font-bold">{s.title}</h3>
					<p class="relative z-10 text-[rgba(0,0,0,0.5)]">{s.des}</p>
				</li>
			)
		})}
	</ul>
</section>