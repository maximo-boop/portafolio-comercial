---
const { t, rubros } = Astro.props;
const whatsappBase = 'https://wa.me/5493512377435?text=';

---

<section class="flex flex-col gap-4 mb-12">
	<span class="text-sm font-semibold uppercase tracking-wider text-[var(--primary)]">{t.eyebrow}</span>
	<h1 class="text-3xl lg:text-5xl font-semibold max-w-3xl">{t.title}</h1>
	<p class="lg:text-lg text-[rgba(0,0,0,0.7)] max-w-2xl">{t.intro}</p>
	<a
		href={`${whatsappBase}${encodeURIComponent(t.whatsappMsg)}`}
		target="_blank"
		rel="noopener noreferrer"
		class="hover:bg-[#181818] text-white p-4 font-bold w-fit bg-[#010101] mt-2"
	>
		{rubros.cta}
	</a>
</section>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-10 mb-16">
	<div class="flex flex-col gap-3">
		<h2 class="text-xl font-bold">{rubros.issues}</h2>
		<ul class="flex flex-col gap-3">
			{t.dolores.map((d: string) => (
				<li class="flex items-start gap-2 text-[rgba(0,0,0,0.7)]">
					<span class="text-[rgba(0,0,0,0.3)] font-bold shrink-0">—</span>
					<span>{d}</span>
				</li>
			))}
		</ul>
	</div>
	<div class="flex flex-col gap-3">
		<h2 class="text-xl font-bold">{rubros.help}</h2>
		<ul class="flex flex-col gap-3">
			{t.comoAyudo.map((c: string) => (
				<li class="flex items-start gap-2 text-[rgba(0,0,0,0.7)]">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--primary)] shrink-0 mt-0.5">
						<path stroke="none" d="M0 0h24v24H0z" fill="none"/>
						<path d="M5 12l5 5l10 -10"/>
					</svg>
					<span>{c}</span>
				</li>
			))}
		</ul>
	</div>
</div>

<section class="border border-[#e5e5e5] bg-white p-6 lg:p-8 flex flex-col gap-4 mb-16">
	<div class="flex items-center justify-between flex-wrap gap-2">
		<h2 class="text-xl font-bold">{rubros.realCase} {t.casoDestacado.title}</h2>
		<span class="text-xs font-semibold uppercase tracking-wider text-[var(--primary)] bg-[var(--primary)]/10 px-2 py-1">
			{t.casoDestacado.rubro}
		</span>
	</div>
	<p class="text-[rgba(0,0,0,0.7)]">{t.casoDestacado.resultado}</p>
	{t.casoDestacado.url && (
		<a href={t.casoDestacado.url} target="_blank" rel="noopener noreferrer" class="inline-flex w-fit items-center gap-1 text-sm font-semibold text-[var(--primary)]">
			Ver sitio <span>→</span>
		</a>
	)}
</section>

{t.faq && (
	<section class="flex flex-col gap-3 mb-16">
		<h2 class="text-xl font-bold">{rubros.ask}</h2>
		{t.faq.map((f: any) => (
			<details class="bg-[#fcfcfc] border border-[#eee]">
				<summary class="flex items-center justify-between cursor-pointer focus:outline-none py-4 px-5">
					<span class="flex-1 font-medium">{f.preg}</span>
					<svg focusable="false" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path stroke="none" d="M0 0h24v24H0z" fill="none"/>
						<path d="M12 5l0 14"/>
						<path d="M5 12l14 0"/>
					</svg>
				</summary>
				<p class="pb-4 pt-0 px-5 text-[rgba(0,0,0,0.7)]">{f.res}</p>
			</details>
		))}
	</section>
)}

<section class="bg-black relative overflow-hidden">
	<div class="absolute inset-0 opacity-[0.08]" style="background-image: radial-gradient(circle, #fff 1px, transparent 1px); background-size: 24px 24px;"></div>
	<div class="py-10 lg:py-12 flex flex-col gap-6 relative z-10 px-6 lg:px-10">
		<h2 class="text-2xl lg:text-3xl font-semibold text-white leading-tight">
			{rubros.charlamos}
		</h2>
		<a
			href={`${whatsappBase}${encodeURIComponent(t.whatsappMsg)}`}
			target="_blank"
			rel="noopener noreferrer"
			class="group flex items-center gap-2 py-4 px-6 font-bold bg-white text-black w-fit"
		>
			{rubros.escribime}
			<span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
		</a>
	</div>
</section>