---
import es from '../data/es.json'
import en from '../data/en.json'

const lang = Astro.url.pathname.startsWith('/') ? 'en' : 'es'
const t = lang === 'en' ? en : es
---

<header class="header z-100 top-5">

	<div class="mx-10 lg:mx-auto lg:flex py-4 px-6 lg:gap-50 lg:w-fit bg-[#fdfdfd]">
		<a href="/" class="font-bold text-xl">{t.header.name}</a>

		<div class="flex gap-2">
			<p>{t.header.title}</p>
		</div>

	</div>


</header>

<style>

	.header:has(#menu-toggle:checked) .nav {
		display: flex;
	}
	.header:has(#menu-toggle:checked){
		height: 100vh;
	}
	
	@media screen and (min-width: 1024px){
		.nav {
			display: flex;
		}
		.hamburger {
			display: none;
		}
	}

</style>