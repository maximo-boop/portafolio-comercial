---
const {t} = Astro.props
---

<section class="flex flex-col-reverse items-center lg:flex-row gap-5 my-40" id="sobre-mi">

	<div class="flex-1 flex flex-col gap-5 min-h-40">
		<h2 class="text-3xl font-semibold lg:text-4xl">{t.title}</h2>
		<p class="text-lg text-[var(--text)]">{t.subtitle}</p>
		<p class="text-lg text-[var(--text)]">{t.subtitleRest}</p>
	</div>

	<div class="flex-1 bg-[#fafafa]">
		<img src="/me.png" alt="Desarrollador web freelance trabajando en una laptop" width="500" height="500" class="w-full h-full" loading="lazy" />
	</div>

</section>