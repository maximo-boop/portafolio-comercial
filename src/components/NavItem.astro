---
// src/components/NavItem.astro
// Uso: <NavItem item={item} />
// item: { title, url, childrens?: [{ title, url }], destacado?: boolean }
const { item } = Astro.props;
---

{!item.childrens ? (
	<li>
		<a
			href={item.url}
			class={item.destacado
				? "bg-black text-white font-medium py-3 px-5 flex lg:inline-flex"
				: "hover:text-[var(--primary)] transition-colors duration-200 flex lg:inline-flex"}
		>
			{item.title}
		</a>
	</li>
) : (
	<li class="group relative">
		<!-- Trigger visible en desktop -->
		<span class="hidden lg:inline-flex items-center gap-1 cursor-default hover:text-[var(--primary)] transition-colors duration-200 py-2">
			{item.title}
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200 group-hover:rotate-180">
				<path stroke="none" d="M0 0h24v24H0z" fill="none"/>
				<path d="M6 9l6 6l6 -6"/>
			</svg>
		</span>

		<!-- Dropdown desktop: hover, sin JS -->
		<div class="hidden lg:block absolute left-0 top-full pt-2 w-64 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200 z-50">
			<ul class="bg-[#fdfdfd] border border-[#e5e5e5] shadow-lg py-2 flex flex-col">
				{item.childrens.map((c) => (
					<li>
						<a href={c.url} class="block px-4 py-2.5 text-sm hover:bg-[#fafafa] hover:text-[var(--primary)] transition-colors duration-150">
							{c.title}
						</a>
					</li>
				))}
			</ul>
		</div>

		<!-- Mobile: acordeón nativo, sin JS -->
		<details class="lg:hidden w-full">
			<summary class="cursor-pointer list-none py-1 font-medium flex items-center justify-between marker:content-none [&::-webkit-details-marker]:hidden">
				{item.title}
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path stroke="none" d="M0 0h24v24H0z" fill="none"/>
					<path d="M6 9l6 6l6 -6"/>
				</svg>
			</summary>
			<ul class="pl-4 flex flex-col gap-3 mt-3">
				{item.childrens.map((c) => (
					<li>
						<a href={c.url} class="block text-sm text-[rgba(0,0,0,0.7)]">{c.title}</a>
					</li>
				))}
			</ul>
		</details>
	</li>
)}