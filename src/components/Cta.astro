---
const {t} = Astro.props
---

<section id="contacto" class=" bg-[var(--secundary)] mb-40">
	<div class="max-w-[1380px] mx-auto global-padding py-14 flex flex-col min-h-80 gap-5 justify-around">
	<div class="flex flex-col gap-2">
		<h2 class="text-2xl lg:text-4xl font-semibold">{t.title}<br class="hidden lg:inline">{t.titleRest}</h2>
		<p class="text-[var(--text)] lg:text-lg">{t.subtitle}</p>
	</div>

	<div class="grid gap-5">
		<div class="flex flex-col lg:flex-row lg:items-center gap-2">
			<a href="https://wa.me/5493512377435" target="_blank" class="flex items-center gap-2 py-4 px-6 font-bold bg-black w-fit text-white">
				{t.cta}
			</a>
			<a href="mailto:maximo2004lfn@gmail.com" class="underline">o por mail</a>
		</div>
		<span>{t.coverLetter}</span>
	</div>
	</div>
</section>